---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Hero from '../components/Hero.astro';
import Servicios from '../components/Servicios.astro';
import Software from '../components/Software.astro';
import Proceso from '../components/Proceso.astro';
import Contacto from '../components/Contacto.astro';
import Footer from '../components/Footer.astro';
import Icon from '../components/Icon.astro';
import '../styles/global.css';

const stats = [
  { num: "24/7", label: "Soporte disponible", color: "var(--c-camaras)" },
  { num: "5", label: "Servicios especializados", color: "var(--naranja)" },
  { num: "100%", label: "Atención personalizada", color: "var(--c-ups)" },
  { num: "A domicilio", label: "Montería y Córdoba", color: "var(--c-redes)" },
];
---

<Layout>
  <Navbar />
  <main id="main-content">
    <Hero />

    <!-- STATS BAR -->
    <div class="stats-bar" aria-label="Datos de Soporte JD">
      {stats.map(s => (
        <div class="stat-item" style={`--color:${s.color}`}>
          <div class="stat-num">{s.num}</div>
          <div class="stat-label">{s.label}</div>
        </div>
      ))}
    </div>

    <Servicios />
    <Software />
    <Proceso />
    <Contacto />
  </main>
  <Footer />

  <!-- BOTÓN FLOTANTE WHATSAPP -->
  <a
    href="https://wa.me/573016537553?text=Hola%2C%20vi%20su%20p%C3%A1gina%20y%20necesito%20informaci%C3%B3n"
    class="wa-float"
    target="_blank"
    rel="noopener noreferrer"
    aria-label="Contactar por WhatsApp"
    title="Chatea con Soporte JD"
  >
    <Icon name="chat" />
  </a>
</Layout>

<style>
.stats-bar {
  display: grid; grid-template-columns: repeat(4, 1fr); gap: 18px;
  margin: -30px 6% 0; position: relative; z-index: 3;
}
.stat-item {
  background: #fff; border-radius: 18px; padding: 22px 16px; text-align: center;
  border: 1px solid var(--borde); box-shadow: var(--sombra);
  border-top: 5px solid var(--color);
}
.stat-num {
  font-family: 'Barlow Condensed', sans-serif;
  font-size: 2.2rem; font-weight: 900; color: var(--color); line-height: 1;
}
.stat-label { font-size: .85rem; font-weight: 600; color: var(--texto-suave); margin-top: 6px; }

@media(max-width: 860px) {
  .stats-bar { grid-template-columns: 1fr 1fr; margin: 0 16px; }
  .stat-num { font-size: 1.7rem; }
}
</style>
