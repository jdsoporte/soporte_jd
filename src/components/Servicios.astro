---
import Icon from './Icon.astro';
import Foto from './Foto.astro';
import { servicios } from '../data/servicios';
---

<section id="servicios" aria-labelledby="servicios-titulo">
  <div class="section-head">
    <span class="section-label">Lo que hacemos</span>
    <h2 class="section-title" id="servicios-titulo">
      Nuestros servicios en <em>Montería, Córdoba</em>
    </h2>
    <p class="section-desc">
      Soluciones tecnológicas completas para hogares y negocios. Atención directa, sin intermediarios, donde tú estés.
    </p>
  </div>

  <div class="servicios-grid">
    {servicios.map((s, i) => (
      <article class="servicio-card" id={s.id} style={`--color:${s.color}`}>
        <div class="card-foto">
          <Foto src={s.foto} alt={s.alt} color={s.color} icon={s.icon} class="card-img" />
          <span class="card-num" aria-hidden="true">0{i + 1}</span>
        </div>
        <div class="card-body">
          <div class="card-icon"><Icon name={s.icon} size={26} /></div>
          <h3>{s.titulo}</h3>
          <p>{s.descripcion}</p>
          <ul class="card-puntos">
            {s.puntos.map(p => <li><Icon name="check" size={16} /> {p}</li>)}
          </ul>
          <a
            href={`https://wa.me/573016537553?text=${encodeURIComponent(`Hola, quiero cotizar: ${s.titulo}`)}`}
            class="card-cta"
            target="_blank"
            rel="noopener noreferrer"
            aria-label={`Cotizar ${s.titulo}`}
          >
            Cotizar este servicio <Icon name="flecha" size={18} />
          </a>
        </div>
      </article>
    ))}
  </div>
</section>

<style>
section { background: #fff; }

.servicios-grid {
  display: grid;
  grid-template-columns: repeat(6, 1fr);
  gap: 26px; margin-top: 52px;
}
/* 3 arriba y 2 abajo centradas */
.servicio-card { grid-column: span 2; }
.servicio-card:nth-child(4) { grid-column: 2 / span 2; }
.servicio-card:nth-child(5) { grid-column: 4 / span 2; }

.servicio-card {
  background: #fff; border-radius: 22px; overflow: hidden;
  border: 1px solid var(--borde);
  box-shadow: var(--sombra);
  display: flex; flex-direction: column;
  transition: transform .3s, box-shadow .3s, border-color .3s;
}
.servicio-card:hover {
  transform: translateY(-8px);
  border-color: color-mix(in srgb, var(--color) 40%, #fff);
  box-shadow: 0 22px 46px color-mix(in srgb, var(--color) 22%, transparent);
}

.card-foto { position: relative; }
.card-foto :global(.card-img) { height: 200px; }
.card-foto::after {
  content: ''; position: absolute; left: 0; right: 0; bottom: 0; height: 5px;
  background: var(--color);
}
.card-num {
  position: absolute; top: 14px; right: 16px;
  font-family: 'Barlow Condensed', sans-serif; font-weight: 900; font-size: 1rem;
  color: #fff; background: var(--color);
  padding: 4px 10px; border-radius: 100px;
}

.card-body { padding: 0 26px 26px; display: flex; flex-direction: column; flex: 1; }
.card-icon {
  width: 56px; height: 56px; border-radius: 16px;
  background: var(--color); color: #fff;
  display: flex; align-items: center; justify-content: center;
  margin-top: -28px; margin-bottom: 16px; position: relative; z-index: 1;
  border: 4px solid #fff;
  box-shadow: 0 8px 20px color-mix(in srgb, var(--color) 40%, transparent);
}
.card-body h3 {
  font-family: 'Barlow Condensed', sans-serif;
  font-size: 1.45rem; font-weight: 800; line-height: 1.1; margin-bottom: 10px;
}
.card-body p { font-size: .93rem; color: var(--texto-suave); line-height: 1.65; }

.card-puntos { list-style: none; margin: 16px 0 0; display: grid; gap: 7px; flex: 1; }
.card-puntos li { display: flex; align-items: center; gap: 8px; font-size: .9rem; font-weight: 600; }
.card-puntos li :global(svg) { color: var(--color); min-width: 16px; }

.card-cta {
  display: inline-flex; align-items: center; gap: 6px; margin-top: 20px;
  color: var(--color); font-weight: 700; font-size: .95rem; text-decoration: none;
}
.card-cta:hover { gap: 10px; }

@media (max-width: 1000px) {
  .servicios-grid { grid-template-columns: 1fr 1fr; }
  .servicio-card, .servicio-card:nth-child(4) { grid-column: auto; }
  .servicio-card:nth-child(5) { grid-column: 1 / -1; max-width: 560px; justify-self: center; width: 100%; }
}
@media (max-width: 640px) {
  .servicios-grid { grid-template-columns: 1fr; }
  .servicio-card:nth-child(5) { max-width: none; }
}
</style>
