---
import Icon from './Icon.astro';

// Foto con fondo de color de respaldo: si la imagen no existe, se ve el color y el ícono
export interface Props {
  src: string;
  alt: string;
  color: string;
  icon: string;
  class?: string;
  eager?: boolean;
}

const { src, alt, color, icon, class: className, eager = false } = Astro.props;
---
<div class:list={['foto', className]} style={`--color:${color}`}>
  <Icon name={icon} size={64} class="foto-icon" />
  <img
    src={src}
    alt={alt}
    loading={eager ? 'eager' : 'lazy'}
    decoding="async"
    onerror="this.remove()"
  />
</div>

<style>
.foto {
  position: relative; overflow: hidden;
  background:
    radial-gradient(circle at 25% 20%, rgba(255,255,255,.35), transparent 55%),
    linear-gradient(135deg, var(--color), color-mix(in srgb, var(--color) 55%, #14213d));
  display: flex; align-items: center; justify-content: center;
}
.foto :global(.foto-icon) { color: rgba(255,255,255,.85); }
.foto img {
  position: absolute; inset: 0;
  width: 100%; height: 100%; object-fit: cover;
}
</style>
