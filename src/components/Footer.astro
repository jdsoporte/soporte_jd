---
import { servicios } from '../data/servicios';
---
<footer role="contentinfo">
  <div class="footer-franja" aria-hidden="true"></div>
  <div class="footer-main">
    <div class="footer-brand">
      <img src="/logo.jpg" alt="Logo Soporte JD" width="150" height="118" loading="lazy" />
      <p>Protege tu espacio, conecta tu futuro. Soluciones tecnológicas para hogares y negocios en Montería y Córdoba.</p>
    </div>

    <nav class="footer-nav" aria-label="Servicios">
      <strong>Servicios</strong>
      {servicios.map(s => <a href={`#${s.id}`} style={`--color:${s.color}`}><i></i>{s.titulo}</a>)}
    </nav>

    <div class="footer-contact">
      <strong>Contacto</strong>
      <a href="https://wa.me/573016537553" target="_blank" rel="noopener">WhatsApp: +57 301 653 7553</a>
      <a href="tel:+573016537553">Teléfono: +57 301 653 7553</a>
      <a href="mailto:jdsoporte98@gmail.com">jdsoporte98@gmail.com</a>
      <span>Montería, Córdoba, Colombia</span>
    </div>

    <div class="footer-contact">
      <strong>Proyectos</strong>
      <a href="https://doret.soportejd.com" target="_blank" rel="noopener">Doret</a>
      <a href="https://distrimas.soportejd.com" target="_blank" rel="noopener">DISTRIMAS</a>
    </div>
  </div>

  <div class="footer-bottom">
    <p>© {new Date().getFullYear()} Soporte JD · Montería, Córdoba, Colombia</p>
    <p>Todos los derechos reservados</p>
  </div>
</footer>

<style>
footer { background: var(--fondo-suave); border-top: 1px solid var(--borde); }
.footer-franja {
  height: 6px;
  background: linear-gradient(90deg, var(--c-camaras), var(--naranja), var(--c-ups), var(--c-redes), var(--c-software));
}
.footer-main {
  padding: 56px 6% 40px;
  display: grid; grid-template-columns: 1.6fr 1.5fr 1.3fr 1fr;
  gap: 40px;
}
@media(max-width: 900px) { .footer-main { grid-template-columns: 1fr 1fr; } }
@media(max-width: 560px) { .footer-main { grid-template-columns: 1fr; padding: 48px 16px 32px; } }

.footer-brand img { width: 150px; height: auto; margin-bottom: 14px; }
.footer-brand p { font-size: .9rem; color: var(--texto-suave); line-height: 1.6; max-width: 300px; }

.footer-nav, .footer-contact { display: flex; flex-direction: column; gap: 10px; }
.footer-nav strong, .footer-contact strong {
  font-size: .8rem; letter-spacing: .12em; color: var(--texto);
  text-transform: uppercase; margin-bottom: 4px;
}
.footer-nav a, .footer-contact a {
  font-size: .92rem; color: var(--texto-suave); text-decoration: none;
  transition: color .2s;
}
.footer-nav a { display: flex; align-items: center; gap: 8px; }
.footer-nav a i { width: 8px; height: 8px; border-radius: 50%; background: var(--color); }
.footer-nav a:hover { color: var(--color); }
.footer-contact a:hover { color: var(--azul); }
.footer-contact span { font-size: .92rem; color: var(--texto-suave); }

.footer-bottom {
  border-top: 1px solid var(--borde);
  padding: 20px 6%; display: flex; flex-wrap: wrap;
  justify-content: space-between; gap: 10px;
}
.footer-bottom p { font-size: .82rem; color: var(--texto-suave); }
</style>
