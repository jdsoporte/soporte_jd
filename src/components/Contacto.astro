---
import Icon from './Icon.astro';
import { servicios } from '../data/servicios';
---
<section id="contacto" aria-labelledby="contacto-titulo">
  <div class="contacto-layout">

    <!-- INFO -->
    <div class="contacto-info">
      <span class="section-label">Contacto</span>
      <h2 class="section-title" id="contacto-titulo">
        Contáctanos <em>hoy mismo</em>
      </h2>
      <p class="section-desc">
        Estamos en <strong>Montería, Córdoba</strong>. Sin oficina presencial, pero siempre disponibles
        para atenderte donde estés. Respuesta rápida garantizada.
      </p>

      <div class="contact-cards">
        <a
          href="https://wa.me/573016537553?text=Hola%2C%20vi%20su%20p%C3%A1gina%20y%20necesito%20informaci%C3%B3n"
          class="ccard" style="--color:#25d366"
          target="_blank" rel="noopener noreferrer"
        >
          <div class="cicon"><Icon name="chat" /></div>
          <div>
            <div class="clabel">WHATSAPP</div>
            <div class="cval">+57 301 653 7553</div>
          </div>
          <Icon name="flecha" size={18} class="carrow" />
        </a>

        <a href="tel:+573016537553" class="ccard" style="--color:var(--c-redes)">
          <div class="cicon"><Icon name="telefono" /></div>
          <div>
            <div class="clabel">TELÉFONO</div>
            <div class="cval">+57 301 653 7553</div>
          </div>
          <Icon name="flecha" size={18} class="carrow" />
        </a>

        <a href="mailto:jdsoporte98@gmail.com" class="ccard" style="--color:var(--naranja)">
          <div class="cicon"><Icon name="correo" /></div>
          <div>
            <div class="clabel">CORREO</div>
            <div class="cval">jdsoporte98@gmail.com</div>
          </div>
          <Icon name="flecha" size={18} class="carrow" />
        </a>

        <div class="ccard" style="--color:var(--c-camaras)">
          <div class="cicon"><Icon name="ubicacion" /></div>
          <div>
            <div class="clabel">UBICACIÓN</div>
            <div class="cval">Montería, Córdoba · Colombia</div>
          </div>
        </div>
      </div>
    </div>

    <!-- FORMULARIO -->
    <form class="form-box" id="formContacto" aria-label="Formulario de contacto Soporte JD">
      <h3 class="form-title">Envíanos un mensaje</h3>
      <p class="form-subtitle">Completa el formulario y te contactamos por WhatsApp de inmediato.</p>

      <div class="form-row">
        <div class="form-group">
          <label for="nombre">Nombre completo</label>
          <input type="text" id="nombre" placeholder="Tu nombre completo" autocomplete="name" />
        </div>
        <div class="form-group">
          <label for="telefono">Teléfono / WhatsApp</label>
          <input type="tel" id="telefono" placeholder="Ej: 300 123 4567" autocomplete="tel" />
        </div>
      </div>
      <div class="form-group">
        <label for="servicio">Servicio de interés</label>
        <select id="servicio">
          <option value="">Selecciona un servicio…</option>
          {servicios.map(s => <option value={s.titulo}>{s.titulo}</option>)}
          <option value="Otro">Otro</option>
        </select>
      </div>
      <div class="form-group">
        <label for="mensaje">Mensaje</label>
        <textarea id="mensaje" placeholder="Cuéntanos qué necesitas…" rows="4"></textarea>
      </div>

      <button class="btn-enviar" type="submit">
        <Icon name="chat" size={20} /> Enviar por WhatsApp
      </button>
      <p class="form-note">Tu mensaje llegará directamente a nuestro WhatsApp.</p>
    </form>

  </div>
</section>

<style>
section { background: #fff; }

.contacto-layout {
  display: grid; grid-template-columns: 1fr 1fr;
  gap: 60px; align-items: start;
}
@media(max-width: 860px) { .contacto-layout { grid-template-columns: 1fr; gap: 44px; } }

.contact-cards { display: flex; flex-direction: column; gap: 14px; margin-top: 32px; }
.ccard {
  display: flex; align-items: center; gap: 16px;
  background: #fff; border: 1px solid var(--borde);
  border-radius: 16px; padding: 16px 18px;
  text-decoration: none; color: var(--texto);
  box-shadow: 0 4px 14px rgba(20,33,61,.04);
  transition: border-color .3s, transform .2s, box-shadow .3s;
}
a.ccard:hover {
  border-color: var(--color); transform: translateX(6px);
  box-shadow: 0 10px 26px color-mix(in srgb, var(--color) 20%, transparent);
}
.cicon {
  width: 48px; height: 48px; min-width: 48px; border-radius: 14px;
  background: color-mix(in srgb, var(--color) 12%, #fff); color: var(--color);
  display: flex; align-items: center; justify-content: center;
}
.clabel { font-size: .72rem; font-weight: 700; color: var(--texto-suave); letter-spacing: .06em; margin-bottom: 2px; }
.cval { font-weight: 700; font-size: 1rem; word-break: break-word; }
.ccard :global(.carrow) { margin-left: auto; color: #c3cad6; min-width: 18px; transition: color .2s; }
.ccard:hover :global(.carrow) { color: var(--color); }

/* Formulario */
.form-box {
  background: #fff; border-radius: 24px; padding: 34px;
  border: 1px solid var(--borde);
  box-shadow: var(--sombra-fuerte);
  position: relative; overflow: hidden;
}
.form-box::before {
  content: ''; position: absolute; top: 0; left: 0; right: 0; height: 6px;
  background: var(--azul);
}
.form-title { font-family: 'Barlow Condensed', sans-serif; font-size: 1.7rem; font-weight: 800; margin-bottom: 4px; }
.form-subtitle { font-size: .92rem; color: var(--texto-suave); margin-bottom: 24px; }
.form-row { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; }
@media(max-width: 520px) { .form-row { grid-template-columns: 1fr; gap: 0; } .form-box { padding: 26px 20px; } }
.form-group { margin-bottom: 16px; }
.form-group label { display: block; font-size: .85rem; font-weight: 700; margin-bottom: 6px; }
.form-group input,
.form-group textarea,
.form-group select {
  width: 100%;
  background: var(--fondo-suave); border: 1.5px solid var(--borde);
  border-radius: 12px; color: var(--texto);
  font-family: 'Barlow', sans-serif; font-size: 1rem;
  padding: 12px 14px; outline: none; transition: border-color .2s, background .2s;
}
.form-group input:focus,
.form-group textarea:focus,
.form-group select:focus { border-color: var(--azul); background: #fff; }
.form-group textarea { resize: vertical; min-height: 100px; }

.btn-enviar {
  width: 100%; display: inline-flex; align-items: center; justify-content: center; gap: 8px;
  background: #25d366; color: #fff;
  font-family: 'Barlow Condensed', sans-serif; font-weight: 700;
  font-size: 1.15rem; letter-spacing: .04em;
  padding: 15px; border: none; border-radius: 12px; cursor: pointer;
  box-shadow: 0 8px 22px rgba(37,211,102,.35);
  transition: filter .2s, transform .15s;
}
.btn-enviar:hover { filter: brightness(.95); transform: translateY(-2px); }
.form-note { font-size: .8rem; color: var(--texto-suave); text-align: center; margin-top: 12px; }
</style>

<script>
  document.getElementById('formContacto')?.addEventListener('submit', (e) => {
    e.preventDefault();
    const nombre   = (document.getElementById('nombre') as HTMLInputElement)?.value.trim() || 'Sin nombre';
    const telefono = (document.getElementById('telefono') as HTMLInputElement)?.value.trim();
    const servicio = (document.getElementById('servicio') as HTMLSelectElement)?.value || 'No especificado';
    const mensaje  = (document.getElementById('mensaje') as HTMLTextAreaElement)?.value.trim();

    let texto = `Hola, soy ${nombre}`;
    if (telefono) texto += ` (Tel: ${telefono})`;
    texto += `.\nServicio de interés: ${servicio}`;
    if (mensaje) texto += `.\n${mensaje}`;

    window.open(`https://wa.me/573016537553?text=${encodeURIComponent(texto)}`, '_blank');
  });
</script>
