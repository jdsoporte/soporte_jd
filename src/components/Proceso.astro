---
import Icon from './Icon.astro';

const pasos = [
  { num: "01", color: "var(--c-camaras)", titulo: "Contáctanos", desc: "Escríbenos por WhatsApp o llena el formulario. Cuéntanos qué necesitas." },
  { num: "02", color: "var(--naranja)", titulo: "Diagnóstico", desc: "Analizamos tu caso y te enviamos una cotización clara y sin letra pequeña." },
  { num: "03", color: "var(--c-ups)", titulo: "Instalación", desc: "Vamos a donde estés en Montería. Instalamos, configuramos y probamos todo." },
  { num: "04", color: "var(--c-redes)", titulo: "Soporte", desc: "Te acompañamos después de la instalación. Siempre disponibles para ayudarte." },
];

const razones = [
  { icon: "casa", color: "var(--c-redes)", titulo: "Servicio a domicilio", desc: "No necesitas desplazarte. Llegamos donde estés en Montería y la región de Córdoba." },
  { icon: "billetera", color: "var(--c-ups)", titulo: "Precios justos", desc: "Cotizaciones claras y precios adaptados a pequeños y medianos negocios." },
  { icon: "personas", color: "var(--naranja)", titulo: "Atención personalizada", desc: "Tratas directamente con el técnico. Sin intermediarios, sin demoras, sin excusas." },
  { icon: "escudo", color: "var(--c-camaras)", titulo: "Trabajo garantizado", desc: "Respaldamos nuestro trabajo. Si algo falla, regresamos sin costo adicional." },
];
---

<!-- PROCESO -->
<section id="proceso" aria-labelledby="proceso-titulo">
  <div class="section-head">
    <span class="section-label">Simple y rápido</span>
    <h2 class="section-title" id="proceso-titulo">¿Cómo <em>funciona?</em></h2>
    <p class="section-desc">En pocos pasos tienes tu solución tecnológica instalada y funcionando.</p>
  </div>

  <ol class="pasos" role="list">
    {pasos.map(p => (
      <li class="paso" style={`--color:${p.color}`}>
        <div class="paso-num" aria-label={`Paso ${p.num}`}>{p.num}</div>
        <h3>{p.titulo}</h3>
        <p>{p.desc}</p>
      </li>
    ))}
  </ol>
</section>

<!-- POR QUÉ ELEGIRNOS -->
<section id="porque" aria-labelledby="porque-titulo">
  <div class="section-head">
    <span class="section-label">Nuestro valor diferencial</span>
    <h2 class="section-title" id="porque-titulo">¿Por qué elegir <em>Soporte JD?</em></h2>
  </div>

  <div class="porque-grid">
    {razones.map(r => (
      <div class="porque-item" style={`--color:${r.color}`}>
        <div class="porque-icon"><Icon name={r.icon} size={26} /></div>
        <h3>{r.titulo}</h3>
        <p>{r.desc}</p>
      </div>
    ))}
  </div>
</section>

<style>
/* PROCESO */
#proceso { background: #fff; }

.pasos {
  display: grid; grid-template-columns: repeat(4, 1fr);
  margin-top: 56px; list-style: none; position: relative;
}
.pasos::before {
  content: ''; position: absolute; top: 36px; left: 12%; right: 12%; height: 4px; border-radius: 4px;
  background: linear-gradient(90deg, var(--c-camaras), var(--naranja), var(--c-ups), var(--c-redes));
  opacity: .35;
}
.paso { text-align: center; padding: 0 18px; position: relative; z-index: 1; }
.paso-num {
  width: 72px; height: 72px; border-radius: 50%;
  background: var(--color); color: #fff;
  border: 5px solid #fff;
  box-shadow: 0 10px 24px color-mix(in srgb, var(--color) 40%, transparent);
  font-family: 'Barlow Condensed', sans-serif; font-size: 1.7rem; font-weight: 900;
  display: flex; align-items: center; justify-content: center;
  margin: 0 auto 18px;
  transition: transform .3s;
}
.paso:hover .paso-num { transform: scale(1.1); }
.paso h3 { font-family: 'Barlow Condensed', sans-serif; font-size: 1.3rem; font-weight: 800; margin-bottom: 8px; }
.paso p { font-size: .92rem; color: var(--texto-suave); line-height: 1.6; }

@media (max-width: 800px) {
  .pasos { grid-template-columns: 1fr 1fr; gap: 36px 0; }
  .pasos::before { display: none; }
}
@media (max-width: 480px) { .pasos { grid-template-columns: 1fr; } }

/* POR QUÉ */
#porque { background: var(--fondo-suave); }

.porque-grid {
  display: grid; grid-template-columns: repeat(4, 1fr);
  gap: 22px; margin-top: 48px;
}
.porque-item {
  background: #fff; border-radius: 20px; padding: 30px 24px;
  border: 1px solid var(--borde); box-shadow: var(--sombra);
  border-bottom: 4px solid var(--color);
  transition: transform .3s, box-shadow .3s;
}
.porque-item:hover { transform: translateY(-6px); box-shadow: var(--sombra-fuerte); }
.porque-icon {
  width: 54px; height: 54px; border-radius: 16px;
  background: color-mix(in srgb, var(--color) 12%, #fff); color: var(--color);
  display: flex; align-items: center; justify-content: center; margin-bottom: 16px;
}
.porque-item h3 { font-family: 'Barlow Condensed', sans-serif; font-size: 1.3rem; font-weight: 800; margin-bottom: 8px; }
.porque-item p { font-size: .92rem; color: var(--texto-suave); line-height: 1.6; }

@media (max-width: 1000px) { .porque-grid { grid-template-columns: 1fr 1fr; } }
@media (max-width: 520px) { .porque-grid { grid-template-columns: 1fr; } }
</style>
